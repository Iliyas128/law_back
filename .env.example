# Обязательно для чата и ingest
GEMINI_API_KEY=

# Порт локальной разработки (на Vercel не используется)
PORT=8787

# --- Векторное хранилище: PostgreSQL + pgvector (продакшен) ---
# Строка подключения (Neon / Supabase / RDS). Для SSL часто добавляют ?sslmode=require
# Neon pooler (рекомендуется для serverless): хост ...-pooler.<region>.neon.tech
PG_URL=
# или стандартное имя для хостингов:
# DATABASE_URL=

# Имя таблицы (только буквы, цифры, подчёркивание)
PG_VECTOR_TABLE=rag_chunks

# Если Node/pg ругается на SSL (часто Supabase локально): только для отладки
# PG_SSL_NO_VERIFY=1

# Проверка связи без импорта:
# npm run db:check

# Локально: хранить чанки в JSON (data/db/chunks.json). На проде обычно не нужно.
# USE_LOCAL_VECTOR_DB=1

# Fallback: скачивание .txt с GitHub Raw, если нет локальных файлов (без PG).
# Укажите свой raw base репозитория с data/docs/... или отключите:
# DOCS_RAW_BASE=0

# JWT (позже)
# JWT_SECRET=

# Модели Gemini (опционально)
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Бюджет thinking-токенов для Gemini 2.5 (главный регулятор скорости):
#   0  — отключить thinking (быстрее в 2-3 раза, по умолчанию у нас).
#   -1 — авто (как у API по умолчанию, медленнее).
#   N  — ограничить N токенов «размышлений».
# GEMINI_THINKING_BUDGET=0

# Сколько фрагментов и какой длины подавать в промпт select+generate.
# Меньше — быстрее и дешевле, но может срезать редкие нюансы.
# RAG_PROMPT_TOP_K=8
# RAG_PROMPT_CHUNK_CHARS=1100

# --- Нейросетевой NER (Transformers.js, Xenova ONNX) ---
# В dev включается по умолчанию; на production (NODE_ENV=production) — выключен (тяжёлое cold-start).
# Включить на Vercel: USE_TRANSFORMER_NER=1  (может быть долгий первый ответ или таймаут без кэша)
# Выключить локально: USE_TRANSFORMER_NER=0
# USE_TRANSFORMER_NER=1
# TRANSFORMER_NER_MODEL=Xenova/bert-base-multilingual-cased-ner-hrl
# TRANSFORMER_NER_MIN_SCORE=0.72

# --- Скорость ответа чата ---
# По умолчанию вместо лишнего LLM-вызова используется быстрый regex-NER + multi-query retrieval,
# а отбор фрагментов и генерация ответа ОБЪЕДИНЕНЫ в один запрос к Gemini (~ -10–15 с).
# Включить дополнительный LLM-расширитель запроса (медленнее, но иногда лучше для разговорных формулировок):
# RAG_LLM_QUERY_EXPAND=1

# Ретраи эмбеддинга при 429/503. По умолчанию 3 попытки с базовой паузой 400 мс.
# RAG_EMBED_RETRIES=3
# RAG_EMBED_RETRY_BASE_MS=400
